// Регресс-защита матрицы прав ролей (roles/*.yaml) через onebase test.
// Утверждать.РольМожет/РольНеМожет гоняют настоящий движок прав — правка роли,
// ломающая эти ожидания, завалит `onebase test`.
Процедура Выполнить()
	// Кладовщик ведёт складские документы...
	Утверждать.РольМожет("Кладовщик", "документ", "ПоступлениеТоваров", "провести", "кладовщик проводит поступление");
	Утверждать.РольНеМожет("Кладовщик", "документ", "ПоступлениеТоваров", "удалять", "кладовщику не выдано удаление");
	// ...но реализацию только видит, не проводит.
	Утверждать.РольМожет("Кладовщик", "документ", "РеализацияТоваров", "читать", "кладовщик видит реализацию");
	Утверждать.РольНеМожет("Кладовщик", "документ", "РеализацияТоваров", "провести", "реализацию проводит не кладовщик");
	// Справочники: номенклатуру правит, организацию только читает.
	Утверждать.РольМожет("Кладовщик", "справочник", "Номенклатура", "изменять", "кладовщик правит номенклатуру");
	Утверждать.РольНеМожет("Кладовщик", "справочник", "Организация", "изменять", "организацию кладовщик не правит");
КонецПроцедуры
