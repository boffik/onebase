// Демо-тест уровня конфигурации (план 108). Запуск:
//   onebase test --project examples/minimal --sqlite :memory:
// Показывает встроенный объект Утверждать: юнит-проверки чистых выражений и
// интеграционную проверку записи/чтения справочника.

Процедура Выполнить()
    // --- юнит: чистые выражения ---
    Утверждать.Равно(2 + 2, 4, "арифметика");
    Утверждать.Равно(ВРег("абв"), "АБВ", "ВРег");
    Утверждать.Истина(СтрНачинаетсяС("Привет, мир", "Привет"), "СтрНачинаетсяС");
    Утверждать.Ложь(1 > 2, "1 не больше 2");
    Утверждать.Заполнено("значение", "непустая строка заполнена");

    // --- интеграция: запись и чтение справочника ---
    Карточка = Справочники.Контрагент.Создать();
    Карточка.Наименование = "ООО Ромашка";
    Карточка.ИНН = "7701234567";
    Ссылка = Карточка.Записать();
    Утверждать.Заполнено(Ссылка, "ссылка после записи заполнена");

    Объект = Ссылка.ПолучитьОбъект();
    Утверждать.Равно(Объект.Наименование, "ООО Ромашка", "наименование прочитано");
    Утверждать.Равно(Объект.ИНН, "7701234567", "ИНН прочитан");
КонецПроцедуры
