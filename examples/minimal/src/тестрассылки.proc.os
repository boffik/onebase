// Демо тест-профиля (план 108, шаг 3): моки внешних эффектов и подменяемые
// часы. Почта/сеть/ОС/ИИ не уходят наружу — эффект записывается в Мок.*, время
// можно заморозить через Часы. Запуск:
//   onebase test --project examples/minimal --sqlite :memory: --run Рассылки

Процедура Выполнить()
    // Часы: замораживаем время — код, завязанный на ТекущаяДата(), детерминирован.
    Часы.Установить(Дата(2026, 7, 29));
    Утверждать.Равно(ТекущаяДата(), Дата(2026, 7, 29), "время заморожено");

    // Почта: без реального SMTP — письма фиксируются в Мок.Email.
    ОтправитьПисьмо("client@example.com", "Вышло обновление 2.0", "Скачайте по ссылке…");

    Письмо = Новый ПисьмоEmail();
    Письмо.Кому = "vip@example.com";
    Письмо.Тема = "Персональная рассылка";
    Письмо.Текст = "Спасибо, что вы с нами";
    Письмо.Отправить();

    Утверждать.Равно(Мок.Email.Количество(), 2, "ушло бы 2 письма");
    Утверждать.Равно(Мок.Email[0].Кому, "client@example.com", "адрес первого письма");
    Утверждать.Равно(Мок.Email[1].Тема, "Персональная рассылка", "тема второго письма");

    Часы.Сбросить();
КонецПроцедуры
