// HTTP-приёмник лидов с сайта (план 61 + план 90, заход 0). Тонкий: парсит единый
// конверт и делегирует в Приёмка.Принять — та же логика headless-проверяема
// обработкой «ТестПриёмка» (без сети и подписи).
//
// Тело POST /hs/site/lead — единый конверт (JSON):
//   {"event_id":"site-1","source":"site","aggregate":"Заявка","correlation_id":"c-1",
//    "payload":{"улица":"Ленина 1","телефон":"+7 999 000-11-22","комментарий":"перезвонить"}}
//
// Ack-семантика (план 90): Код результата уходит HTTP-статусом (200 Принято/Дубль;
// 409/422 Карантин/Отклонено) — чтобы мост/отправитель корректно решал ack/nack.
Функция Лид(Запрос) Экспорт
    Конверт = Запрос.ТелоJSON();
    Рез = Приёмка.Принять(Конверт);
    Тело = Новый Структура;
    Тело.Вставить("статус", Рез.Получить("Статус"));
    Тело.Вставить("результат", Рез.Получить("Результат"));
    Тело.Вставить("сообщение", Рез.Получить("Сообщение"));
    Возврат ОтветJSON(Рез.Получить("Код"), Тело);
КонецФункции
