// Ядро входной приёмки произвольного события (план 90, ЗАХОД 0 — прикладной паттерн
// пробела G6). Тонкие транспортные обработчики (HTTP-сервис «Сайт», обработки-
// имитаторы) только парсят конверт и зовут Приёмка.Принять — вся гарантия здесь,
// в одном месте, повторно используемая и headless-проверяемая без HTTP/подписи
// (обработкой ТестПриёмка).
//
// Единый конверт (CC-INT-003), независимо от транспорта:
//   { event_id, schema_version, correlation_id, source, aggregate, occurred_at, payload }
//   event_id — ключ идемпотентности; payload — тело события (поля Заявки).
//
// ЧЕСТНЫЕ ОГРАНИЧЕНИЯ захода 0 (их закрывает только заход 1 в движке):
//   1. «НайтиПоРеквизиту + Создать» НЕ атомарны → гонка TOCTOU: два параллельных
//      дубля оба не найдут ключ и оба заведут заявку. Нужен storage-примитив с
//      UNIQUE(intake,scope,key) + INSERT … ON CONFLICT DO NOTHING.
//   2. Создание заявки и отметка «обработано» — НЕ в одной транзакции: сбой между
//      ними даёт дубль или потерю. Нужен WithTx на стороне движка.
//   3. Канонизация тела — простая сериализация ЗаписатьJSON (порядок ключей может
//      влиять на сверку). Заход 1 канонизирует payload и хэширует (sha256).

// СтрЗнач(Соотв, Ключ) → строковое значение по ключу или "".
Функция СтрЗнач(Соотв, Ключ)
    Если Соотв = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Знач = Соотв.Получить(Ключ);
    Если Знач = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Знач);
КонецФункции

// Ответ(Статус, Код, Сообщение, Результат) — единый результат приёмки (Соответствие).
//   Статус ∈ { Принято | Дубль | Карантин | Отклонено }
//   Код    — HTTP-код для транспорта (ack-семантика плана 90)
Функция Ответ(Статус, Код, Сообщение, Результат)
    Р = Новый Соответствие;
    Р.Вставить("Статус", Статус);
    Р.Вставить("Код", Код);
    Р.Вставить("Сообщение", Сообщение);
    Р.Вставить("Результат", Результат);
    Возврат Р;
КонецФункции

// СоздатьЗаявку(Payload) → ссылка (строка) на созданную Заявку. Запись прогоняет
// управляемую валидацию (план 89, ПриЗаписи Заявки): блокирующее правило бросает
// исключение — его ловит вызывающий и уводит событие в карантин.
Функция СоздатьЗаявку(Payload)
    Док = Документы.Заявка.Создать();
    Док.Дата        = ТекущаяДата();
    Док.Улица       = СтрЗнач(Payload, "улица");
    Док.Телефон     = СтрЗнач(Payload, "телефон");
    Док.Комментарий = СтрЗнач(Payload, "комментарий");
    // Запись документа возвращает ссылку на созданный объект (как у справочника).
    СсылкаОбъекта = Док.Записать();
    Возврат Строка(СсылкаОбъекта);
КонецФункции

// ЗаписьСобытия(...) — отметка идемпотентности: событие принято, вот его результат.
Процедура ЗаписьСобытия(Ключ, Источник, ТелоКанон, СсылкаРезультат, Корр)
    З = Справочники.ОбработанныеСобытия.Создать();
    З.Наименование    = Ключ;
    З.Ключ            = Ключ;
    З.Источник        = Источник;
    З.ТелоКанон       = ТелоКанон;
    З.СсылкаРезультат = СсылкаРезультат;
    З.Корреляция      = Корр;
    З.Момент          = ТекущаяДата();
    З.Записать();
КонецПроцедуры

// ВКарантин(...) — отложить «битое» событие в DLQ. По одному ключу — одна запись:
// повторный сбой увеличивает счётчик попыток, а не плодит дубли.
Процедура ВКарантин(Ключ, Источник, ТипОбъекта, Конверт, Причина, ТекстОшибки, Корр)
    Сущ = Документы.КарантинСобытий.НайтиПоРеквизиту("Ключ", Ключ);
    Если ЗначениеЗаполнено(Сущ) Тогда
        Об = Сущ.ПолучитьОбъект();
        ТекПопыток = Об.Попытки;
        Если ЗначениеЗаполнено(ТекПопыток) = Ложь Тогда
            ТекПопыток = 0;
        КонецЕсли;
        Об.Попытки   = Число(ТекПопыток) + 1;
        Об.Причина   = Причина;
        Об.Ошибка    = ТекстОшибки;
        Об.Состояние = "Открыт";
        Об.Записать();
        Возврат;
    КонецЕсли;
    К = Документы.КарантинСобытий.Создать();
    К.Дата       = ТекущаяДата();
    К.Ключ       = Ключ;
    К.Источник   = Источник;
    К.ТипОбъекта = ТипОбъекта;
    К.ТелоСырое  = ЗаписатьJSON(Конверт);
    К.Причина    = Причина;
    К.Ошибка     = ТекстОшибки;
    К.Попытки    = 1;
    К.Состояние  = "Открыт";
    К.Корреляция = Корр;
    К.Записать();
КонецПроцедуры

// Принять(Конверт) → результат приёмки. Идемпотентно по event_id.
Функция Принять(Конверт) Экспорт
    Ключ       = СтрЗнач(Конверт, "event_id");
    Источник   = СтрЗнач(Конверт, "source");
    ТипОбъекта = СтрЗнач(Конверт, "aggregate");
    Корр       = СтрЗнач(Конверт, "correlation_id");

    Payload = Неопределено;
    Если Конверт <> Неопределено Тогда
        Payload = Конверт.Получить("payload");
    КонецЕсли;

    // Без ключа дедуплицировать нечем → отклоняем (422), в карантин не кладём.
    Если ПустаяСтрока(Ключ) Тогда
        Возврат Ответ("Отклонено", 422, "Конверт без event_id — нет ключа идемпотентности", "");
    КонецЕсли;

    // Без тела не из чего создавать бизнес-объект → несовпадение схемы, в карантин.
    Если Payload = Неопределено Тогда
        ВКарантин(Ключ, Источник, ТипОбъекта, Конверт, "НесовпадениеСхемы", "Конверт без payload", Корр);
        Возврат Ответ("Карантин", 422, "Конверт без payload → карантин", "");
    КонецЕсли;

    ТелоКанон = ЗаписатьJSON(Payload);

    // Идемпотентность: этот ключ уже видели?
    Существующее = Справочники.ОбработанныеСобытия.НайтиПоРеквизиту("Ключ", Ключ);
    Если ЗначениеЗаполнено(Существующее) Тогда
        ПрежнееТело = Строка(ЗначениеРеквизитаОбъекта(Существующее, "ТелоКанон"));
        Если ПрежнееТело = ТелоКанон Тогда
            // Настоящий дубль: то же тело — вернуть прежний результат, НЕ обрабатывать заново.
            Рез = Строка(ЗначениеРеквизитаОбъекта(Существующее, "СсылкаРезультат"));
            Возврат Ответ("Дубль", 200, "Событие уже принято ранее", Рез);
        Иначе
            // Тот же ключ, другое тело — подмена/расхождение схемы → карантин (CC-DATA-105).
            ВКарантин(Ключ, Источник, ТипОбъекта, Конверт, "НесовпадениеСхемы",
                "event_id повторяется с другим payload", Корр);
            Возврат Ответ("Карантин", 409, "Ключ повторяется с другим телом → карантин", "");
        КонецЕсли;
    КонецЕсли;

    // Новый ключ. [TOCTOU: здесь окно гонки — см. шапку модуля.]
    // Создаём бизнес-объект; запись Заявки прогоняет управляемую валидацию (план 89):
    // блокирующее правило → исключение → событие уходит в карантин (ОшибкаОбработчика).
    Попытка
        СсылкаЗаявки = СоздатьЗаявку(Payload);
    Исключение
        ВКарантин(Ключ, Источник, ТипОбъекта, Конверт, "ОшибкаОбработчика", ОписаниеОшибки(), Корр);
        Возврат Ответ("Карантин", 422, "Обработчик отклонил событие → карантин", "");
    КонецПопытки;

    // Отметка «обработано» (не в одной транзакции с созданием — ограничение захода 0).
    ЗаписьСобытия(Ключ, Источник, ТелоКанон, СсылкаЗаявки, Корр);
    Возврат Ответ("Принято", 200, "Заявка создана", СсылкаЗаявки);
КонецФункции

// Повторить(КарантинСсылка) → результат повторной приёмки: читает сырой конверт из
// карантина, прогоняет через ту же Принять (идемпотентность соблюдается) и, если
// принято/дубль, помечает запись карантина «Повторён».
Функция Повторить(КарантинСсылка) Экспорт
    ТелоСырое = Строка(ЗначениеРеквизитаОбъекта(КарантинСсылка, "ТелоСырое"));
    Конверт = ПрочитатьJSON(ТелоСырое);
    Рез = Принять(Конверт);
    Статус = Рез.Получить("Статус");
    Если Статус = "Принято" ИЛИ Статус = "Дубль" Тогда
        Об = КарантинСсылка.ПолучитьОбъект();
        Об.Состояние = "Повторён";
        Об.Записать();
    КонецЕсли;
    Возврат Рез;
КонецФункции
