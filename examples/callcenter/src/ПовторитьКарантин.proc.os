// Массовый повтор всех открытых записей карантина через ту же приёмку (replay,
// план 90, заход 0). Идемпотентность соблюдается: уже принятые ключи вернут «Дубль»,
// всё ещё «битые» (неисправленная причина) останутся в карантине с ростом счётчика
// попыток. Успешно повторённые помечаются «Повторён». В интерфейсе это кнопка
// «Повторить» в списке карантина (заход 1 / UI); здесь — операционная обработка.
Процедура Выполнить()

    // Ключи открытого карантина; ссылку получаем через НайтиПоРеквизиту — колонка
    // «Ссылка» в запросе даёт лишь UUID, а ЗначениеРеквизитаОбъекта/ПолучитьОбъект
    // ждут полноценную ссылку менеджера.
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Ключ КАК Ключ ИЗ Документ.КарантинСобытий ГДЕ Состояние = &Сост";
    Запрос.УстановитьПараметр("Сост", "Открыт");
    Выборка = Запрос.Выполнить();

    Всего = 0;
    Успешно = 0;
    Для Каждого Стр Из Выборка Цикл
        Ключ = Строка(Стр.Ключ);
        КарРеф = Документы.КарантинСобытий.НайтиПоРеквизиту("Ключ", Ключ);
        Если ЗначениеЗаполнено(КарРеф) Тогда
            Всего = Всего + 1;
            Рез = Приёмка.Повторить(КарРеф);
            Статус = Рез.Получить("Статус");
            Сообщить("Карантин " + Ключ + " → " + Статус);
            Если Статус = "Принято" ИЛИ Статус = "Дубль" Тогда
                Успешно = Успешно + 1;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Сообщить("Повтор завершён: обработано " + Строка(Всего) + ", успешно " + Строка(Успешно) + ".");

КонецПроцедуры
