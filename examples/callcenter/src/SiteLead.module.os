// Обработчик входного шлюза SiteLead (план 90, ЗАХОД 1 — движок internal/intake).
// В отличие от захода 0 здесь обработчик — ТОЛЬКО бизнес-логика: идемпотентность,
// карантин и транзакцию обеспечивает движок (Ingest). Процедура Обработать
// запускается ВНУТРИ транзакции приёмки, поэтому запись Заявки и отметка
// «обработано» коммитятся вместе; исключение (например блокирующее правило
// валидации, план 89) откатывает Заявку и уводит событие в карантин.

// Обработать(Конверт) → ссылка на созданную Заявку. Конверт — единый JSON-конверт
// (Соответствие), payload несёт поля Заявки.
Функция Обработать(Конверт) Экспорт
    Payload = Конверт.Получить("payload");
    Док = Документы.Заявка.Создать();
    Док.Дата        = ТекущаяДата();
    Док.Улица       = Строка(Payload.Получить("улица"));
    Док.Телефон     = Строка(Payload.Получить("телефон"));
    Док.Комментарий = Строка(Payload.Получить("комментарий"));
    СсылкаОбъекта = Док.Записать();
    Возврат Строка(СсылкаОбъекта);
КонецФункции
