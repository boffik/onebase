// Headless-демонстрация входной приёмки (план 90, заход 0, пробел G6) — без сети и
// подписи: зовём Приёмка.Принять напрямую, ту же логику, что и HTTP-сервис «Сайт».
//
// ТРЕБУЕТ опубликованных правил валидации (обработка «ЗаполнитьПравилаВалидации»):
// сценарий 4 опирается на блокирующее правило REQ-STREET (улица обязательна) —
// именно оно уводит «битый» лид в карантин. Запуск проверки:
//   onebase procrun --proc ЗаполнитьПравилаВалидации ... && onebase procrun --proc ТестПриёмка ...
Процедура Выполнить()

    Сообщить("=== Тест входной приёмки (план 90, заход 0) ===");

    // 1 — happy-path: валидный лид принят, создана Заявка.
    Payload1 = ЛидPayload("Ленина 1", "+7 999 000-11-22", "перезвонить утром");
    Р1 = Приёмка.Принять(Конверт("evt-1", Payload1));
    Печать("1. happy-path", Р1);

    // 2 — дубль: тот же event_id и то же тело → «Дубль», второй Заявки нет.
    Р2 = Приёмка.Принять(Конверт("evt-1", Payload1));
    Печать("2. дубль (тот же ключ+тело)", Р2);

    // 3 — несовпадение: тот же event_id, другое тело → карантин (НесовпадениеСхемы).
    Payload3 = ЛидPayload("Ленина 1", "+7 999 000-99-99", "другое тело");
    Р3 = Приёмка.Принять(Конверт("evt-1", Payload3));
    Печать("3. несовпадение схемы (тот же ключ, другое тело)", Р3);

    // 4 — ошибка обработчика: лид без улицы → блокирующее правило плана 89 (REQ-STREET)
    //     бросает исключение → карантин (ОшибкаОбработчика).
    Payload4 = ЛидPayload("", "+7 999 000-33-44", "нет улицы — правило заблокирует");
    Р4 = Приёмка.Принять(Конверт("evt-2", Payload4));
    Печать("4. ошибка обработчика (нет улицы → BLOCK)", Р4);

    // 5 — починка и повтор: оператор исправляет данные в карантине (добавляет улицу)
    //     и повторяет. Повтор идёт через ту же Принять → Заявка создаётся, запись
    //     карантина помечается «Повторён».
    КарРеф = Документы.КарантинСобытий.НайтиПоРеквизиту("Ключ", "evt-2");
    Если ЗначениеЗаполнено(КарРеф) Тогда
        Об = КарРеф.ПолучитьОбъект();
        Об.ТелоСырое = ЗаписатьJSON(Конверт("evt-2", ЛидPayload("Мира 5", "+7 999 000-33-44", "починено")));
        Об.Записать();
        Р5 = Приёмка.Повторить(КарРеф);
        Печать("5. починка+повтор из карантина", Р5);
    КонецЕсли;

    Сообщить("");
    Сообщить("Смотри данные: справочник «Обработанные события» и документы «Карантин событий».");
    Сообщить("Массовый повтор всех открытых — обработка «ПовторитьКарантин».");

КонецПроцедуры

// Конверт(ИдСобытия, Payload) → единый конверт (Соответствие, как из ТелоJSON).
Функция Конверт(ИдСобытия, Payload)
    К = Новый Соответствие;
    К.Вставить("event_id", ИдСобытия);
    К.Вставить("source", "site");
    К.Вставить("aggregate", "Заявка");
    К.Вставить("correlation_id", "corr-" + ИдСобытия);
    К.Вставить("payload", Payload);
    Возврат К;
КонецФункции

// ЛидPayload(Улица, Телефон, Комментарий) → тело события (Соответствие).
Функция ЛидPayload(Улица, Телефон, Комментарий)
    P = Новый Соответствие;
    P.Вставить("улица", Улица);
    P.Вставить("телефон", Телефон);
    P.Вставить("комментарий", Комментарий);
    Возврат P;
КонецФункции

// Печать(Метка, Рез) — краткий отчёт по результату приёмки.
Процедура Печать(Метка, Рез)
    Сообщить(Метка + " → статус=" + Рез.Получить("Статус")
        + " код=" + Строка(Рез.Получить("Код"))
        + " результат=" + Рез.Получить("Результат"));
КонецПроцедуры
