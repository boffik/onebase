// Регресс-защита ПДн-маскирования (план 88) и RLS (план 79) роли Оператор.
// Ассерты гоняют настоящие access.FieldDecisions / access.Decide — те же, что и
// боевой enforcement. Ослабление field_access/row_access завалит `onebase test`.
Процедура Выполнить()
	// Полевой доступ: телефон и почта клиента — под маской, имя открыто.
	Утверждать.ПолеМаскируется("Оператор", "справочник", "Клиент", "Телефон", "телефон КЦ под маской");
	Утверждать.ПолеМаскируется("Оператор", "справочник", "Клиент", "Email", "почта под маской");
	Утверждать.ПолеВидно("Оператор", "справочник", "Клиент", "Наименование", "имя клиента открыто");
	// Точная маска: mask_tail keep=4 оставляет последние 4 цифры.
	Утверждать.МаскаПоля("Оператор", "справочник", "Клиент", "Телефон", "9161234567", "••••••4567", "последние 4 цифры");
	// Строковый доступ: свои задачи — под фильтром, клиентов видит всех.
	Утверждать.СтрокиОграничены("Оператор", "документ", "Задача", "читать", "оператор видит только свои задачи");
	Утверждать.СтрокиНеОграничены("Оператор", "справочник", "Клиент", "читать", "клиентов оператор видит всех");
КонецПроцедуры
