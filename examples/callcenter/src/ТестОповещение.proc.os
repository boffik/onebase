// Обработка «Тест: оповещение и команды UI» (план 87, ступень B). Шлёт ТЕКУЩЕМУ
// пользователю важный тост со ссылкой и команду обновления списка. Всё адресовано
// вашему логину, поэтому видно именно у вас (на любой открытой странице).
// Запускайте после «Заполнить демоданные».
Процедура Выполнить()
    Логин = ИмяПользователя();
    Если ПустаяСтрока(Логин) Тогда
        Логин = "*";
    КонецЕсли;

    // Ссылка на список «Заявки» — клик по тосту откроет его (в оболочке — вкладкой).
    Ссылка = Новый Структура;
    Ссылка.Вставить("вид", "document");
    Ссылка.Вставить("сущность", "Заявка");

    // 1) Богатый тост «важное» — не исчезает сам (закрыть крестиком); клик по нему
    //    открывает «Заявки». Так проверяется и ui.оповещение, и открытие формы.
    ПоказатьОповещениеПользователя(Логин, "Тест оповещения (ступень B)",
        "Важный тост — клик открывает «Заявки», крестик закрывает.", Ссылка, "важное");

    // 2) Императивно перечитать открытый список «Заявка» (работает даже без
    //    list_refresh_on у него — контейнеры несут data-ob-live).
    ДанныеСписка = Новый Структура;
    ДанныеСписка.Вставить("сущность", "Заявка");
    ОтправитьУведомление(Логин, "ui.обновитьСписок", ДанныеСписка);

    Сообщить("Отправлено. Важный тост появится на ваших ДРУГИХ открытых страницах "
        + "(эта перезагрузилась при запуске «Выполнить» и потеряла своё SSE). "
        + "Клик по тосту откроет «Заявки»; открытый список «Заявка» перечитается.");
КонецПроцедуры
