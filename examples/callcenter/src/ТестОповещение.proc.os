// Обработка «Тест: оповещение и команды UI» (план 87, ступень B). Шлёт ТЕКУЩЕМУ
// пользователю три клиентские команды: важный тост, обновление списка и открытие
// формы. Всё адресовано вашему логину, поэтому видно именно у вас (на любой
// открытой странице). Запускайте после «Заполнить демоданные».
Процедура Выполнить()
    Логин = ИмяПользователя();
    Если ПустаяСтрока(Логин) Тогда
        Логин = "*";
    КонецЕсли;

    // 1) Богатый тост «важное» — не исчезает сам (закрыть крестиком).
    ПоказатьОповещениеПользователя(Логин, "Тест оповещения (ступень B)",
        "Важный тост — закройте крестиком.", Неопределено, "важное");

    // 2) Императивно перечитать открытый список «Заявка» (работает даже без
    //    list_refresh_on у него — контейнеры несут data-ob-live).
    ДанныеСписка = Новый Структура;
    ДанныеСписка.Вставить("сущность", "Заявка");
    ОтправитьУведомление(Логин, "ui.обновитьСписок", ДанныеСписка);

    // 3) Открыть список «Заявка» во вкладке у пользователя.
    ДанныеФормы = Новый Структура;
    ДанныеФормы.Вставить("вид", "document");
    ДанныеФормы.Вставить("сущность", "Заявка");
    ОтправитьУведомление(Логин, "ui.открытьФорму", ДанныеФормы);

    Сообщить("Отправлено: важный тост + обновление списка «Заявка» + открытие формы. "
        + "Всплывашка появится на любой открытой странице.");
КонецПроцедуры
